# Generate a unique server-only value before starting the application.
TOKEN_SIGNING_SECRET=replace-with-a-long-random-secret
# Access-token lifetime in seconds. Valid range: 1-86400.
TOKEN_TTL_SECONDS=3600
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-secret
MYSQL_PASSWORD=replace-with-a-long-random-database-password
EMBEDDING_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
EMBEDDING_API_KEY=replace-with-private-course-key
EMBEDDING_MODEL=course-embedding
EMBEDDING_DIM=2048
CHAT_MODEL=course-chat
GATEWAY_TIMEOUT_SECONDS=10
# Optional approved connectors JSON. Empty uses the internal demonstration service.
# Use [] to disable all connectors. Keep credentials in private environment values.
PLATFORM_CONNECTORS_JSON=
